# Authentication method: "key" (default) or "entra"
FOUNDRY_AUTH=key

FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/

# Required when FOUNDRY_AUTH=key (ignored when using Entra ID)
FOUNDRY_API_KEY=<your-api-key>

FOUNDRY_DEPLOYMENT=gpt-4o
FOUNDRY_API_VERSION=2024-12-01-preview

# --- Entra ID: Service Principal (optional, only when FOUNDRY_AUTH=entra) ---
# Set all three to authenticate as a service principal.
# If only AZURE_CLIENT_ID is set (no secret), it is treated as a
# user-assigned managed identity client ID.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
